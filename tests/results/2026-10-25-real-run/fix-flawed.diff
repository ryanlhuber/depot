diff --git a/src/cart.js b/src/cart.js
index 80b6388..ca3982b 100644
--- a/src/cart.js
+++ b/src/cart.js
@@ -16,7 +16,11 @@ function applyCoupon(subtotalCents, coupon) {
 
 function cartTotal(items, coupons = []) {
   let total = items.reduce((sum, i) => sum + lineTotal(i), 0);
-  for (const c of coupons) total = applyCoupon(total, c);
+  for (const c of coupons) {
+    total = applyCoupon(total, c);
